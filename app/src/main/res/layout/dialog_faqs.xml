<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="24dp"
    android:background="@drawable/custom_input_bg"
    android:padding="0dp">

    <View
        android:id="@+id/dialogHeader"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/modal_info" />

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:text="Frequently Asked Questions"
        android:textColor="@color/app_text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp">
        <TextView
            android:id="@+id/dialogMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Q: How do I change my profile picture?\nA: Click on the 'Upload Profile Picture' button on your dashboard.\n\nQ: How do I change my password?\nA: Click 'Change Password' (local users only).\n\nQ: Is my data secure?\nA: We use standard security practices to protect your data."
            android:textColor="@color/app_text_primary"
            android:textSize="16sp" />
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dialogOkBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:minHeight="56dp"
        android:text="Close"
        android:textColor="@color/white"
        android:backgroundTint="@color/app_button" />

</LinearLayout>
